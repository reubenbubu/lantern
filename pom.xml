<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>io.lantern</groupId>
  <artifactId>lantern-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Lantern</name>

  <modules>
    <module>lantern-core</module>
    <module>lantern-sandbox</module>
    <module>lantern-extract</module>
    <module>lantern-link</module>
    <module>lantern-derive</module>
    <module>lantern-llm</module>
    <module>lantern-summarize</module>
    <module>lantern-compose</module>
    <module>lantern-app</module>
    <module>lantern-web</module>
    <module>lantern-archtest</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <anthropic-java.version>3.3.0</anthropic-java.version>
    <archunit.version>1.5.1</archunit.version>
    <javaparser.version>3.28.2</javaparser.version>
    <jsqlparser.version>5.3</jsqlparser.version>
    <spotless.version>3.10.4</spotless.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <node.version>v24.21.0</node.version>
    <!-- 1.37.0 fails under spotless-maven-plugin 3.10.4 (IllegalAccessError into jdk.compiler). -->
    <google-java-format.version>1.36.1</google-java-format.version>
    <!-- The Lantern properties file whose Maven mirror the tests' sandbox builds use (ADR 0030).
         Empty means none, so they use Maven Central. Set it in a profile of Maven's settings, or
         with -Dlantern.test.properties=<absolute path>. -->
    <lantern.test.properties></lantern.test.properties>
    <!-- The local Maven repository whose downloads FixtureBuildIT reads. scripts/full-check.sh
         sets it to the shared one, as it runs Maven on a repository of its own chained to it. -->
    <lantern.test.localRepository>${settings.localRepository}</lantern.test.localRepository>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-sandbox</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-extract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-link</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-derive</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-llm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-summarize</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-compose</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-app</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lantern</groupId>
        <artifactId>lantern-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.anthropic</groupId>
        <artifactId>anthropic-java</artifactId>
        <version>${anthropic-java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.javaparser</groupId>
        <artifactId>javaparser-symbol-solver-core</artifactId>
        <version>${javaparser.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.jsqlparser</groupId>
        <artifactId>jsqlparser</artifactId>
        <version>${jsqlparser.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- Lantern has no annotation processors of its own. Lombok is on the classpath for the
               Java extractor to run, not to process Lantern's code. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <proc>none</proc>
          </configuration>
        </plugin>
        <plugin>
          <!-- A property from Maven's settings does not reach the test JVMs by itself. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- *IT classes are failsafe's, also those whose names start with Test. -->
            <excludes>
              <exclude>**/*$*</exclude>
              <exclude>**/*IT.java</exclude>
            </excludes>
            <systemPropertyVariables>
              <lantern.test.properties>${lantern.test.properties}</lantern.test.properties>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <lantern.test.properties>${lantern.test.properties}</lantern.test.properties>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <!-- Records generated from the vocabulary's attribute schemas (ADR 0090); a test of
                 their module checks them against the generator instead. -->
            <excludes>
              <exclude>src/main/java/io/lantern/*/attributes/**</exclude>
            </excludes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
