<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.lantern</groupId>
    <artifactId>lantern-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lantern-compose</artifactId>
  <name>Lantern Compose</name>

  <dependencies>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-summarize</artifactId>
    </dependency>
    <dependency>
      <!-- The golden tests extract the fixture projects' facts with the real extractors. -->
      <groupId>io.lantern</groupId>
      <artifactId>lantern-extract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- ... and fold their deployable units as the linker does. -->
      <groupId>io.lantern</groupId>
      <artifactId>lantern-link</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The fixture projects live with the extractors that were their first user. -->
            <lantern.test.fixtures>${maven.multiModuleProjectDirectory}/lantern-extract/src/test/resources/fixtures</lantern.test.fixtures>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
