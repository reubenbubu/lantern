<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.lantern</groupId>
    <artifactId>lantern-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lantern-app</artifactId>
  <name>Lantern App</name>

  <dependencies>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-extract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-compose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Keep the plain jar as the main artifact so other modules (archtest) can use it. -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
