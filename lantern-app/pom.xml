<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.lantern</groupId>
    <artifactId>lantern-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lantern-app</artifactId>
  <name>Lantern App</name>

  <properties>
    <!-- A Maven repository to run EndToEndIT on as well, as an absolute path; none if empty. -->
    <lantern.test.repo></lantern.test.repo>
    <!-- The folder project-0 was set up in (testsets/project-0/setup.sh), which Project0EndToEndIT
         then requires; if empty, it runs on the default folder if project-0 is set up there. -->
    <lantern.test.project0></lantern.test.project0>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-extract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-link</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-harness</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-summarize</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-compose</artifactId>
    </dependency>
    <dependency>
      <!-- Carries the single-file HTML template that documents are rendered into. -->
      <groupId>io.lantern</groupId>
      <artifactId>lantern-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The report specs' HTML templates, for the renderers that write documents into them
             (docs/adr/0031-report-spec-renderer.md). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>report-spec-templates</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/report-specs</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../report-specs</directory>
                  <includes>
                    <include>*/*.html</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Keep the plain jar as the main artifact so other modules (archtest) can use it. -->
          <classifier>exec</classifier>
          <requiresUnpack>
            <!-- The Java extractor runs Lombok, which loads its classes from its own jar file. -->
            <dependency>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </dependency>
          </requiresUnpack>
        </configuration>
      </plugin>
      <plugin>
        <!-- Runs *IT integration tests during verify. Executions come from the Spring Boot parent. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The fixture projects live with the extractors that were their first user. -->
            <lantern.test.fixtures>${maven.multiModuleProjectDirectory}/lantern-extract/src/test/resources/fixtures</lantern.test.fixtures>
            <lantern.test.repo>${lantern.test.repo}</lantern.test.repo>
            <lantern.test.project0>${lantern.test.project0}</lantern.test.project0>
          </systemPropertyVariables>
          <!-- Runs the classes in 4 JVMs side by side, each taking the next class when it is free,
               in alphabetical order, so EndToEndIT, the longest, starts early.
               Each JVM has its own Spring contexts, and with them its own PostgreSQL containers;
               the classes write to folders of their own and label their sandbox builds with an
               owner of their own, so they share no database, folder, port or system property. -->
          <forkCount>4</forkCount>
          <reuseForks>true</reuseForks>
          <runOrder>alphabetical</runOrder>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
