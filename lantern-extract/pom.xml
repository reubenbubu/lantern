<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.lantern</groupId>
    <artifactId>lantern-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>lantern-extract</artifactId>
  <name>Lantern Extract</name>

  <properties>
    <!-- A directory of OpenWMS clones (testsets/openwms/clone.sh); OpenWmsMavenIT runs if set. -->
    <lantern.test.openwms></lantern.test.openwms>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lantern</groupId>
      <artifactId>lantern-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <!-- The Java extractor's fallback parser, for repositories whose build failed. -->
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
    </dependency>
    <dependency>
      <!-- Lantern's own Lombok, run by the Java extractor in place of the analyzed build's copy.
           Version from Spring Boot. -->
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Runs *IT integration tests during verify. Executions come from the Spring Boot parent. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- FixtureBuildIT builds the fixtures with this project's Maven wrapper... -->
            <lantern.test.mvnw>${maven.multiModuleProjectDirectory}/mvnw</lantern.test.mvnw>
            <!-- ...reading, but never writing, the local repository of the outer build. -->
            <lantern.test.localRepository>${settings.localRepository}</lantern.test.localRepository>
            <lantern.test.openwms>${lantern.test.openwms}</lantern.test.openwms>
            <!-- The OpenWMS test set's Lantern settings: the Maven repositories its builds use. -->
            <lantern.test.openwms.settings>${maven.multiModuleProjectDirectory}/testsets/openwms/lantern.properties</lantern.test.openwms.settings>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
