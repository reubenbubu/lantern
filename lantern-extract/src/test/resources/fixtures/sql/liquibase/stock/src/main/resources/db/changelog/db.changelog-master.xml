<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <include file="changes/001-warehouse.yaml" relativeToChangelogFile="true"/>

  <changeSet id="2" author="test">
    <createTable tableName="stock_item">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="stock_item_pk"/>
      </column>
      <column name="warehouse_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="stock_item_warehouse_fk" references="warehouse(id)"/>
      </column>
      <column name="sku" type="VARCHAR(40)">
        <constraints nullable="false" unique="true" uniqueConstraintName="stock_item_sku_uk"/>
      </column>
      <column name="qty" type="INT"/>
    </createTable>
    <rollback>
      <dropTable tableName="stock_item"/>
    </rollback>
  </changeSet>

  <changeSet id="3" author="test">
    <renameColumn tableName="stock_item" oldColumnName="qty" newColumnName="quantity"/>
    <addNotNullConstraint tableName="stock_item" columnName="quantity"/>
    <modifyDataType tableName="stock_item" columnName="sku" newDataType="varchar(64)"/>
    <sql>ALTER TABLE stock_item ADD COLUMN reserved INT NOT NULL DEFAULT 0;</sql>
  </changeSet>

  <includeAll path="db/changelog/more/"/>
</databaseChangeLog>
